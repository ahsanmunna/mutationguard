# MutationGuard Environment Template
# Copy this file to .env.local and adjust your local credentials.

# Database Connections (Must point to designated PostgreSQL databases)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/antigravity_dev

# TEST_DATABASE_URL requirement:
# 1. Must never equal DATABASE_URL.
# 2. Database name MUST end with '_test' (e.g. antigravity_test or any_custom_name_test).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/antigravity_test

# Database Write Confirmation Guard
# Set to 'true' only when intentionally permitting migration, seed, or reset commands
MUTATIONGUARD_ALLOW_DB_WRITE=false

# Demo Mode Toggle: enables the one-click demo login and the demo panel (reviewer only).
# Set to false (or remove) for any deployment that must not allow password-free login.
DEMO_MODE=true

# Session signing secret (REQUIRED, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the app refuses to start sessions with a placeholder like this one.
SESSION_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# Password given to the seeded demo users by `npm run db:seed` (synthetic accounts only).
DEMO_PASSWORD=demo123

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Hosted database only (Vercel): the exact database name the app may write to, e.g. neondb.
# Leave this OUT of .env.local so local runs keep using antigravity_dev / antigravity_test.
# ALLOWED_DATABASE_NAME=neondb